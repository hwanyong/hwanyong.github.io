---
import BaseHead from '../components/BaseHead.astro';
import LangSwitch from '../components/LangSwitch.astro';
import AdSenseHead from '../components/AdSenseHead.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import { SITE } from '../lib/site';
import { LOCALES, type Alternate, type Locale } from '../lib/i18n';
import {
  NAV_SECTIONS,
  type NavSection,
  feedHref,
  homeHref,
  sectionHref,
  sectionLabel,
} from '../lib/routes';
import { UI } from '../lib/ui';
import { GITHUB } from '../lib/profile';
import { HINTS } from '../lib/shortcuts';
// fonts.css 가 --font-serif / --font-mono 를 정의하므로 global.css 보다 먼저 온다.
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/code.css';
import '../styles/ads.css';

interface Props {
  /**
   * ★ 필수다. 기본값을 두지 않는다 — 빠뜨리면 컴파일이 죽어야 한다.
   *   기본값을 두면 새 라우트가 조용히 기본 로케일로 렌더되고, 그 화면의 네비·푸터·
   *   피드 링크가 전부 다른 언어의 트리를 가리키게 된다.
   */
  locale: Locale;
  /**
   * 이 화면의 언어별 주소. head 의 hreflang 과 헤더의 언어 스위처가 같은 값을 읽는다 —
   * 둘이 다른 출처를 보면 "스위처는 있는데 hreflang 이 없는" 화면이 생긴다.
   * 언어축 밖(404)은 빈 배열이고, 그러면 스위처도 hreflang 도 렌더되지 않는다.
   */
  alternates: Alternate[];
  /** false 면 canonical 대신 noindex 를 낸다(404 전용). */
  indexable?: boolean;
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /**
   * 광고를 띄우면 안 되는 화면은 false.
   * (태그 목록·아카이브·404 등 "publisher-content 가 없는 화면"은
   *  Google Publisher Policies 상 광고 게재 금지 대상이다.
   *  개정축의 구버전 페이지도 replicated content 라 빼는 편이 안전하다.)
   */
  ads?: boolean;
  /**
   * 현재 위치를 aria-current 로 표시할 네비 항목.
   * privacy 는 네비에 없으므로 여기 올 수 없다 — 타입이 그것을 막는다.
   */
  section?: NavSection | null;
}

// 메뉴는 routes.ts 의 NAV_SECTIONS 가 그대로다 — 경로·표기·키를 여기서 다시 적지 않는다.
// ★ 항목이 0개인 축도 빠지지 않는다. 축이 비어 있다는 사실은 그 축의 목록 화면이
//   직접 말하고, 네비에서 사라지는 쪽은 "그런 축이 없다" 로 읽혀 더 나쁘다.
//   그래서 이 레이아웃은 콘텐츠 계층(content.ts)을 아예 import 하지 않는다.

const {
  locale,
  alternates,
  indexable = true,
  title,
  description,
  type,
  publishedTime,
  ads = true,
  section = null,
} = Astro.props;

const t = UI[locale];
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang} data-mode="reflect">
  <head>
    <BaseHead
      locale={locale}
      alternates={alternates}
      indexable={indexable}
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
    />

    {/*
      FOUC 방지. 첫 페인트 전에 동기 실행되어야 하므로 defer 가 붙는 번들 스크립트로는
      대체할 수 없다. 코드는 public/theme-init.js 에 있고 여기서는 참조만 한다.

      is:inline 은 "코드를 인라인한다"는 뜻이 아니라 "Astro 가 이 태그를 처리(번들·
      TS 변환)하지 말라"는 지시자다. public/ 의 파일을 참조할 때 필요하며,
      출력 HTML 에는 <script src="/theme-init.js"> 만 남는다.
    */}
    <script is:inline src="/theme-init.js"></script>

    {/*
      클라이언트 동작의 유일한 진입점. Astro 가 번들해 type="module"(defer)로 낸다.

      각 컴포넌트가 자기 <script> 를 갖지 않는 이유: Astro 5+ 는 컴포넌트
      스크립트를 head 로 hoist 하지 않고 선언된 자리에 남긴다. body 안에 놓이는
      컴포넌트(Comments 등)가 스크립트를 가지면 그대로 body 스크립트가 된다.
      각 init* 는 대상 요소가 없으면 즉시 반환하므로 모든 페이지에서 안전하다.
    */}
    <script>
      import { initTheme } from '../scripts/theme';
      import { initScan } from '../scripts/scan';
      import { initKeyboard } from '../scripts/keyboard';
      import { initGiscus } from '../scripts/giscus';
      import { initVideo } from '../scripts/video';

      initTheme();
      initScan();
      initKeyboard();
      initGiscus();
      initVideo();
    </script>

    {/* AdSense 로더는 </head> 안. 페이지당 정확히 1회. */}
    {ads && <AdSenseHead />}

    {/* 분석 비콘. 일부러 ads 게이트 밖에 둔다 — 광고를 끈 화면(처리방침 등)의
        방문이 통계에서 빠지면 "아무도 안 본다"는 잘못된 결론이 나온다.
        쿠키를 심지 않으므로 동의 배너 없이 모든 화면에서 켤 수 있다. */}
    <AnalyticsHead />

    {/*
      ClientRouter(뷰 트랜지션)는 기본적으로 켜지 않는다.
      - AdSense: 전환마다 슬롯을 다시 push 하면 '사용자 요청 없는 새로고침'
        정책에 저촉될 수 있고, Google 이 SPA 라우팅을 명시적으로 허용한 문서가 없다.
      - giscus: 전환마다 위젯을 재초기화해야 하고 옵저버 누적 관리가 필요하다.
      켤 경우: import { ClientRouter } from 'astro:transitions'; 후 여기에 <ClientRouter />
      를 넣고, 인라인 스크립트에 data-astro-rerun 을 검토할 것.
    */}
  </head>

  <body>
    <header class="site-header">
      {/* 브랜드는 아이콘 하나. width/height 를 원본 픽셀로 박아 CLS 를 막고,
          실제 표시 크기는 CSS 가 정한다. alt 는 로고가 대신하는 글자 그대로. */}
      <a class="site-header__brand" href={homeHref(locale)}>
        <img src="/icon.png" alt="UHD" width="512" height="512" />
      </a>
      {/* 헤더는 모든 페이지에서 같은 모양이어야 한다. 페이지마다 구성이 달라지면
          "여기선 왜 안 나오지" 가 되어 버그로 읽힌다. 좁은 화면에서만 CSS 가 접는다. */}
      <span class="site-header__tagline">{t.site.description}</span>
      {/* RSS 는 여기 두지 않는다 —
          피드 발견은 <head> 의 rel="alternate" 가, 사람이 누르는 링크는 푸터가 맡는다. */}
      <nav class="site-nav">
        {NAV_SECTIONS.map((key) => (
          <a href={sectionHref(locale, key)} aria-current={section === key ? 'page' : undefined}>
            {sectionLabel(key)}
          </a>
        ))}
      </nav>
      {/*
        헤더 우측에는 언어 칩 하나만 온다.

        ★ 예전에는 여기에 상태 칩(.site-status)이 있었다 — "10 PROJECTS" · "REV 1 / 1" ·
          "4 TBD" · 방침 시행일 · "404". 전부 화면 어딘가에 이미 있는 사실이었다.
          개수는 목록 끝의 Pagination 이, 개정본 위치는 개정 이력 패널이, 시행일은
          방침 본문이, TBD 는 그 문단 자신이 말한다. 한 자리에서 여러 뜻을 돌려 쓰는
          칩은 화면마다 규칙을 새로 배우게 만든다. 다시 만들지 말 것.
      */}
      {alternates.length > 0 && <LangSwitch locale={locale} alternates={alternates} />}
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getUTCFullYear()} {SITE.author}</span>
      <a href={GITHUB.href}>{GITHUB.platform}</a>
      <a href={feedHref(locale)}>RSS</a>
      {/* 고지 문서는 어느 화면에서나 ★자기 언어로★ 한 번에 닿아야 한다 —
          "prominent and easily accessible" 이 다국어에서 뜻하는 바가 이것이다. */}
      <a href={sectionHref(locale, 'privacy')}>{sectionLabel('privacy')}</a>
    </footer>

    {/*
      NieR 커맨드 힌트 바.
      각인은 src/lib/shortcuts.ts 의 HINTS 를 그대로 읽는다 — 안내와 동작이 같은 표에서
      나오므로 어긋날 수 없다. 항목을 추가할 때는 그 표와 scripts/keyboard.ts 의 동작을 함께 넣을 것.
      (검색 `/` 은 검색 자체가 없어서 없다. 검색이 생기면 그때 표에 한 줄이 는다.)
    */}
    <div class="command-bar">
      {HINTS.map((hint) => (
        <span class="command-bar__item">
          {hint.keys.map((binding) => <kbd>{binding.cap}</kbd>)}
          {t.hints[hint.labelKey]}
        </span>
      ))}
      <span class="command-bar__spacer"></span>
      {/*
        오른쪽 끝은 상태 칩 자리다. 좁은 화면에서는 힌트가 접히고 이 둘만 남으므로
        터치 기기에서 무늬·조명을 바꿀 수 있는 유일한 경로가 된다.
        조명 칩을 맨 끝에 두는 것은 위치가 바뀌면 손이 헤매기 때문이다.

        라벨은 여기 쓰지 않는다 — global.css 의 [data-scan] · [data-mode] 블록이
        --scan-label / --state-label 로 넣는다. 실제 무늬와 같은 자리에서 나와야
        버튼과 화면이 어긋날 수 없다.
      */}
      <div class="command-bar__controls">
        <button class="command-bar__state command-bar__state--scan" type="button" id="scan-toggle" aria-label={t.scanToggle}>
          <i class="command-bar__grid" aria-hidden="true"></i>
        </button>
        <button class="command-bar__state command-bar__state--mode" type="button" id="mode-toggle" aria-label={t.backlightToggle}>
          <i class="command-bar__dot" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </body>
</html>
