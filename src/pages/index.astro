---
// 홈 — 글과 작업물을 하나의 시간축에 섞어 보여준다.
// 두 축을 나눠 놓으면 "언제 무엇을 했는지"가 두 목록으로 쪼개져 읽히지 않는다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { getTimeline, groupByYear } from '../lib/content';
import { AD_SLOTS } from '../lib/site';
import { DEFAULT_LOCALE } from '../lib/i18n';
import { UI } from '../lib/ui';

// S3 에서 Astro.props.locale 로 대체된다. 지금은 정문 하나뿐이다.
const locale = DEFAULT_LOCALE;
const t = UI[locale];

const items = await getTimeline();
const groups = groupByYear(items);
---

<BaseLayout
  locale={locale}
  title={t.site.title}
  description={t.site.description}
  status={`${items.length} ENTRIES`}
>
  <Timeline locale={locale} groups={groups} adAfter={3} adSlot={AD_SLOTS.inFeed} />
</BaseLayout>
