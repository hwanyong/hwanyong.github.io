---
// src/pages/project/[series]/[...version].astro — 개인 프로젝트 개정본 상세.
//
// 화면과 URL 규칙은 RevisionPage 가 전부 갖는다(강의 축과 같은 골격).
// 이 축에만 있는 것은 기술 스택·외부 링크 블록이며, lead 슬롯으로 꽂는다.
import { render } from 'astro:content';
import RevisionPage from '../../../components/RevisionPage.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import { getSeriesHistories, versionSlug } from '../../../lib/content';
import type { ProjectEntry } from '../../../lib/content';
import { DEFAULT_LOCALE } from '../../../lib/i18n';

export const getStaticPaths = async () => {
  const histories = await getSeriesHistories('project');

  return histories.flatMap(({ series, revisions }) =>
    revisions.map((entry, index) => ({
      // 최신(index 0)은 version 을 비워 계열 루트로 낸다.
      // rest 파라미터는 빈 세그먼트도 매칭하므로 라우트 하나가 둘 다 낸다.
      params: { series, version: index === 0 ? undefined : versionSlug(entry) },
      props: { revisions, index },
    })),
  );
};

type Props = { revisions: ProjectEntry[]; index: number };

const { revisions, index }: Props = Astro.props;

// S3 에서 Astro.props.locale 로 대체된다.
const locale = DEFAULT_LOCALE;

const entry = revisions[index]!;
const { Content } = await render(entry);

const { stack, links, thumbnail, video } = entry.data;

// 링크는 스키마 순서가 아니라 여기 정한 순서로 나온다.
// 라벨을 마크업에 흩뿌리지 않으려고 한 표로 모아 둔다.
const LINK_LABELS = [
  ['repo', 'GitHub'],
  ['package', 'Package'],
  ['demo', 'Demo'],
] as const;

const linkRow = LINK_LABELS.flatMap(([key, label]) => {
  const href = links[key];
  return href ? [{ href, label }] : [];
});
---

<RevisionPage locale={locale} collection="project" revisions={revisions} index={index}>
  {(stack.length > 0 || linkRow.length > 0) && (
    <dl class="fact" slot="lead">
      {stack.length > 0 && (
        <div class="fact__row">
          <dt>Stack</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
      )}
      {linkRow.length > 0 && (
        <div class="fact__row">
          <dt>Links</dt>
          <dd class="fact__links">
            {linkRow.map(({ href, label }) => (
              <a href={href} rel="noopener noreferrer" target="_blank">{label}</a>
            ))}
          </dd>
        </div>
      )}
    </dl>
  )}

  {/* 영상이 있으면 본문보다 먼저. 재생 전에는 포스터 한 장이라 무겁지 않다.
      포스터는 목록 썸네일과 같은 파일을 쓴다 — 같은 그림을 두 번 두지 않는다. */}
  {video && thumbnail && (
    <VideoFacade locale={locale} id={video.id} title={video.title} poster={thumbnail} />
  )}

  <Content />
</RevisionPage>
