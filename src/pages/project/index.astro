---
// 개인 프로젝트 목록 (개정축). 정렬·draft 필터는 src/lib/content.ts 에 있다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getSeriesTimeline, groupByYear } from '../../lib/content';
import { AD_SLOTS } from '../../lib/site';
import { DEFAULT_LOCALE } from '../../lib/i18n';
import { sectionLabel } from '../../lib/routes';
import { UI } from '../../lib/ui';

// S3 에서 Astro.props.locale 로 대체된다.
const locale = DEFAULT_LOCALE;
const t = UI[locale];

const items = await getSeriesTimeline('project');
const groups = groupByYear(items);
---

<BaseLayout
  locale={locale}
  title={sectionLabel('project')}
  description={t.lists.project.description}
  section="project"
  ads={items.length > 0}
  status={`${items.length} PROJECTS`}
>
  {/* 인피드 슬롯에는 게이트가 없다 — 항목이 adAfter 개보다 적으면 Timeline 의
      루프가 애초에 광고 행을 만들지 않는다. 게이트가 필요한 곳은 로더 쪽(ads)이다. */}
  <Timeline
    locale={locale}
    groups={groups}
    adAfter={3}
    adSlot={AD_SLOTS.inFeed}
  />
</BaseLayout>
