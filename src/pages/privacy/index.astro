---
// src/pages/privacy/index.astro — 개인정보처리방침.
//
// 본문은 전부 src/lib/privacy.ts 에 있다. 이 파일은 배치만 한다
// (profile.ts ↔ about 과 같은 구조).
//
// 광고를 띄우지 않는다: 고지 문서는 publisher content 가 아니다.
// 그리고 이 페이지는 광고 승인 요건상 어느 화면에서나 1클릭에 닿아야 하므로
// 푸터 링크(BaseLayout)와 짝을 이룬다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import { DEFAULT_LOCALE } from '../../lib/i18n';
import { formatDate, isoDate } from '../../lib/date';
import {
  POLICY,
  POLICY_TEXT,
  STORAGE_KEYS,
  VENDOR_IDS,
  VENDORS,
} from '../../lib/privacy';

// S3 에서 Astro.props.locale 로 대체된다.
const locale = DEFAULT_LOCALE;

// ★ 폴백 헬퍼를 거치지 않는다. 방침은 모든 로케일에 반드시 있어야 하고,
//   없으면 화면이 조용히 다른 언어를 보여주는 대신 컴파일이 죽는 것이 맞다.
const t = POLICY_TEXT[locale];
const effective = formatDate(POLICY.effective);
---

<BaseLayout
  locale={locale}
  title={t.title}
  description={t.metaDescription}
  ads={false}
  status={effective}
>
  <div class="column">
    <header class="post-header">
      <div class="post-header__meta">
        <time datetime={isoDate(POLICY.effective)}>{t.effectiveLabel} {effective}</time>
      </div>
      <h1 class="post-header__title">{t.title}</h1>
      <p class="post-header__lead">{t.lead}</p>
    </header>

    <section class="prose">
      {(['noAccount', 'thirdPartyOnly'] as const).map((key) => <p>{t.intro[key]}</p>)}
    </section>

    {/* <h2 class="section-bar"> 는 계기판 요소지만 그 안의 글자는 문서 목차다.
        Log/Lecture 같은 축 이름이 아니므로 비번역 대상이 아니다. */}
    <h2 class="section-bar"><b>{t.headings.storage}</b></h2>
    <section class="prose">
      <table>
        <thead>
          <tr>
            <th>{t.tableHead.name}</th>
            <th>{t.tableHead.kind}</th>
            <th>{t.tableHead.owner}</th>
            <th>{t.tableHead.purpose}</th>
            <th>{t.tableHead.retention}</th>
          </tr>
        </thead>
        <tbody>
          {STORAGE_KEYS.map((key) => (
            <tr>
              <td><code>{key}</code></td>
              <td>{t.storage[key].kind}</td>
              <td>{t.storage[key].owner}</td>
              <td>{t.storage[key].purpose}</td>
              <td>{t.storage[key].retention}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {(['notCookie', 'onlyIfToggled', 'howToDelete'] as const).map((key) => (
        <p>{t.storageNote[key]}</p>
      ))}
    </section>

    <h2 class="section-bar"><b>{t.headings.thirdParty}</b></h2>
    <section class="prose">
      {VENDOR_IDS.map((id) => (
        <>
          <h3>{VENDORS[id].name}</h3>
          <p>
            <strong>{t.purposeLabel}</strong> {t.vendors[id].purpose} ·{' '}
            <strong>{t.cookiesLabel}</strong> {t.vendors[id].cookies}
            {!VENDORS[id].active && <> · <strong>{t.inactiveNote}</strong></>}
          </p>
          <p>{t.vendors[id].detail}</p>
          <p>
            <a href={VENDORS[id].policyHref} rel="noopener noreferrer" target="_blank">
              {t.vendorPolicyLink(VENDORS[id].name)}
            </a>
          </p>
        </>
      ))}
    </section>

    <h2 class="section-bar"><b>{t.headings.retention}</b></h2>
    <section class="prose">
      {(['nothingHeld', 'whereItLives'] as const).map((key) => <p>{t.retention[key]}</p>)}
    </section>

    {/* 관할 고지. 두 관할이 모두 실린다 —
        운영자가 한국에 있어 PIPA 가 항상 적용되고, EEA 방문자에게는 GDPR 이 적용된다.
        읽는 언어가 아니라 정보주체의 소재로 갈리므로 언어별로 나누지 않는다. */}
    <h2 class="section-bar"><b>{t.rights.heading}</b></h2>
    <section class="prose">
      {t.rights.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <h3>{t.rights.pipa.label}</h3>
      {t.rights.pipa.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <strong>{t.rights.pipa.officerLabel}</strong> {SITE.author} ·{' '}
        <a href={`mailto:${POLICY.contact}`}>{POLICY.contact}</a>
      </p>

      <h3>{t.rights.gdpr.label}</h3>
      {t.rights.gdpr.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <strong>{t.rights.gdpr.controllerLabel}</strong> {SITE.author} ·{' '}
        <a href={`mailto:${POLICY.contact}`}>{POLICY.contact}</a>
      </p>
      <p><strong>{t.rights.gdpr.legalBasis.label}</strong></p>
      {t.rights.gdpr.legalBasis.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p><strong>{t.rights.gdpr.transfers.label}</strong></p>
      {t.rights.gdpr.transfers.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <strong>{t.rights.gdpr.supervisoryAuthority.label}</strong>{' '}
        {t.rights.gdpr.supervisoryAuthority.text}
      </p>

      <p>
        <strong>{t.contactLabel}</strong>{' '}
        <a href={`mailto:${POLICY.contact}`}>{POLICY.contact}</a>
      </p>
    </section>

    <h2 class="section-bar"><b>{t.headings.changes}</b></h2>
    <section class="prose">
      <p>{t.changes.weWillPost}</p>
      <p>{t.effectiveDateLabel} {effective}</p>
    </section>
  </div>
</BaseLayout>
