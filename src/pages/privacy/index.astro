---
// src/pages/privacy/index.astro — 개인정보처리방침.
//
// 내용은 전부 src/lib/privacy.ts 에 있다. 이 파일은 배치만 한다
// (profile.ts ↔ about/index.astro 와 같은 구조).
//
// ads={false} 인 이유: 본문이 얇은 고지 화면이다. Google Publisher Policies 는
// publisher-content 가 빈약한 페이지에 광고를 붙이는 것을 금지한다.
// 분석(AnalyticsHead)은 ads 와 무관하게 켜지므로 이 페이지 방문도 집계된다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  POLICY,
  INTRO,
  STORAGE,
  STORAGE_NOTE,
  THIRD_PARTIES,
  RETENTION,
  RIGHTS,
  CHANGES,
} from '../../lib/privacy';
---

<BaseLayout
  title="개인정보처리방침"
  description="이 블로그가 어떤 정보를 어떻게 다루는지에 대한 안내"
  ads={false}
  status={POLICY.effective}
>
  <div class="column">
    <header class="post-header">
      <div class="post-header__meta">
        <time datetime={POLICY.effective}>시행 {POLICY.effective}</time>
      </div>
      <h1 class="post-header__title">개인정보처리방침</h1>
      <p class="post-header__lead">
        이 블로그가 어떤 정보를 어떻게 다루는지 적어둔 문서입니다.
      </p>
    </header>

    <section class="prose">
      {INTRO.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <h2 class="section-bar"><b>브라우저에 남는 값</b></h2>

    <section class="prose">
      <table>
        <thead>
          <tr>
            <th>이름</th>
            <th>종류</th>
            <th>주체</th>
            <th>목적</th>
            <th>보관</th>
          </tr>
        </thead>
        <tbody>
          {STORAGE.map((row) => (
            <tr>
              <td><code>{row.name}</code></td>
              <td>{row.kind}</td>
              <td>{row.owner}</td>
              <td>{row.purpose}</td>
              <td>{row.retention}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {STORAGE_NOTE.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <h2 class="section-bar"><b>제3자 서비스</b></h2>

    <section class="prose">
      {THIRD_PARTIES.map((party) => (
        <>
          <h3>{party.name}</h3>
          <p>
            <strong>용도</strong> {party.purpose} · <strong>쿠키</strong> {party.cookies}
            {!party.active && <> · <strong>현재 사용하지 않음</strong></>}
          </p>
          <p>{party.detail}</p>
          <p>
            <a href={party.policyHref} rel="noopener noreferrer" target="_blank">
              {party.name} 개인정보 정책
            </a>
          </p>
        </>
      ))}
    </section>

    <h2 class="section-bar"><b>보유와 파기</b></h2>

    <section class="prose">
      {RETENTION.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <h2 class="section-bar"><b>이용자의 권리와 문의</b></h2>

    <section class="prose">
      {RIGHTS.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <strong>문의</strong>{' '}
        <a href={`mailto:${POLICY.contact}`}>{POLICY.contact}</a>
      </p>
    </section>

    <h2 class="section-bar"><b>변경</b></h2>

    <section class="prose">
      {CHANGES.map((paragraph) => <p>{paragraph}</p>)}
      <p>시행일 {POLICY.effective}</p>
    </section>
  </div>
</BaseLayout>
