---
// src/pages/about/index.astro — 소개.
//
// 데이터는 전부 src/lib/profile.ts 에 있다. 이 파일은 배치만 한다.
// INTRO·CAREER 는 아직 자리표시자이며, draft 인 동안 화면에 TBD 표시가 붙는다.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../lib/site';
import { LOCALE_CODES } from '../../../lib/i18n';
import { langParam, staticAlternates } from '../../../lib/routes';
import type { Locale } from '../../../lib/i18n';

export const getStaticPaths = () =>
  LOCALE_CODES.map((locale) => ({ params: { lang: langParam(locale) }, props: { locale } }));
import { UI } from '../../../lib/ui';
import Toc from '../../../components/Toc.astro';
import { ROLE, INTRO, CAREER, ACCOUNTS } from '../../../lib/profile';

const { locale } = Astro.props as { locale: Locale };
const t = UI[locale];
const alternates = staticAlternates('about');

/* 목차. 이 화면은 마크다운이 아니라 템플릿이라 제목이 render() 를 거치지 않는다.
   그래서 headings 를 손으로 만든다 — 아래 <h2> 의 id 와 ★반드시★ 같아야 하므로
   두 곳에 각각 쓰지 않고 이 배열 하나에서 뽑아 쓴다. */
const sections = [
  { slug: 'career', text: t.about.career },
  { slug: 'accounts', text: t.about.accounts },
] as const;
const headings = sections.map((s) => ({ depth: 2, slug: s.slug, text: s.text }));

// 아직 채우지 않은 항목 수. 헤더 상태 칸에 그대로 띄워 잊지 못하게 한다.
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title="About"
  description={`${SITE.author} — ${ROLE}`}
  section="about"
>
  <div class="column">
    <header class="post-header">
      <div class="post-header__meta">
        <span>{ROLE}</span>
      </div>
      <h1 class="post-header__title">{SITE.author}</h1>
      <p class="post-header__lead">{t.site.description}</p>
    </header>

    <section class="prose about-intro" data-tbd={INTRO.draft || undefined}>
      {INTRO.draft && <p class="tbd-note">{t.about.tbdNote}</p>}
      {INTRO.paragraphs[locale].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <h2 class="section-bar" id={sections[0].slug}><b>{sections[0].text}</b></h2>

    <ol class="career">
      {CAREER.map((entry) => (
        <li data-tbd={entry.draft || undefined}>
          <div class="career__head">
            {/* EN DASH 와 '재직 중' 은 조판과 문구라 뷰가 넣는다 —
                데이터에는 'YYYY.MM' 숫자만 있다. */}
            <time class="career__period">{entry.from} – {entry.to ?? t.about.present}</time>
            {entry.draft && <em class="career__tbd">TBD</em>}
          </div>
          <p class="career__where">
            <b>{entry.company[locale]}</b>
            <span>{entry.role[locale]}</span>
          </p>
          <p class="career__summary">{entry.summary[locale]}</p>
        </li>
      ))}
    </ol>

    <h2 class="section-bar" id={sections[1].slug}><b>{sections[1].text}</b></h2>

    <ul class="accounts">
      {ACCOUNTS.map((account) => (
        <li>
          <a href={account.href} rel="me noopener noreferrer" target="_blank">
            {account.avatar ? (
              <img
                class="accounts__mark"
                src={account.avatar}
                alt=""
                width="108"
                height="108"
                loading="lazy"
              />
            ) : (
              /* 아바타가 없으면 서비스 이름 첫 글자로 같은 크기의 자리를 채운다 */
              <span class="accounts__mark accounts__mark--plate" aria-hidden="true">
                {account.platform.slice(0, 1)}
              </span>
            )}
            <span class="accounts__text">
              <b>
                {account.platform} <span class="accounts__handle">{account.handle}</span>
              </b>
              <span class="accounts__note">{account.note[locale]}</span>
            </span>
            <span class="accounts__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    {/* ArticleShell 을 쓰지 않는 화면이라 레일을 여기서 직접 놓는다.
        자리가 맨 아래인 이유는 다른 상세 화면과 같다 — 사이드 열이 닫히는 좁은
        화면에서 DOM 순서가 곧 화면 순서이고, 그때 목차는 감춰진다. */}
    <div class="side-rail">
      <Toc locale={locale} headings={headings} />
    </div>
  </div>
</BaseLayout>

{/* .career / .accounts / .tbd-note 스타일은 src/styles/global.css 에 있다.
    스타일이 페이지마다 흩어지면 토큰 SSOT 가 깨진다. */}
