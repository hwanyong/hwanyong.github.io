---
// 글 목록 (시간축). 정렬·draft 필터는 src/lib/content.ts 에 있다.
//
// 라우트가 index.astro 가 아니라 [...page].astro 인 이유:
//   1쪽의 주소는 /log/ 여야 하고(목록 자신이 1쪽이다) 2쪽부터 /log/2/ 여야 한다.
//   rest 파라미터에 undefined 를 주면 그 세그먼트가 URL 에서 통째로 사라지므로
//   라우트 하나가 두 모양을 다 낸다. paginate() 가 정확히 그 규칙으로 params 를 만든다.
//
// ★ 같은 자리에 /log/<groupKey>/ 도 있다([key].astro). 숫자만으로 된 groupKey 는
//   routes.ts 의 URL_KEY 가 막으므로 두 라우트가 같은 URL 을 주장할 수 없다.
//
// ★ getStaticPaths 는 격리 호이스팅된다 — import 와 함수 내부 선언만 쓴다.
import type { Page, PaginateFunction } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Timeline from '../../../components/Timeline.astro';
import Pagination from '../../../components/Pagination.astro';
import { PAGE_SIZE, getLogTimeline, groupByYear } from '../../../lib/content';
import type { TimelineItem } from '../../../lib/content';
import { AD_SLOTS } from '../../../lib/site';
import { LOCALE_CODES } from '../../../lib/i18n';
import { langParam, pagedAlternates, sectionHref, sectionLabel } from '../../../lib/routes';
import { UI } from '../../../lib/ui';
import type { Locale } from '../../../lib/i18n';

// 모든 로케일에 항상 존재하는 화면이다. 로케일은 콘텐츠가 아니라 LOCALE_CODES 에서
// 나온다 — 방침·소개·목록은 번역이 없어도 URL 이 있어야 하는 유일한 부류다.
// 항목이 0개여도 paginate() 는 1쪽을 낸다(lastPage 는 최소 1).
export const getStaticPaths = async ({ paginate }: { paginate: PaginateFunction }) => {
  const perLocale = await Promise.all(
    LOCALE_CODES.map(async (locale) =>
      paginate(await getLogTimeline(locale), {
        params: { lang: langParam(locale) },
        props: { locale },
        pageSize: PAGE_SIZE,
      }),
    ),
  );
  return perLocale.flat();
};

const { locale, page } = Astro.props as { locale: Locale; page: Page<TimelineItem> };
const t = UI[locale];

// n쪽의 짝은 다른 언어의 같은 n쪽이다.
const alternates = pagedAlternates('log', page.currentPage);

const groups = groupByYear(page.data);
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={sectionLabel('log')}
  description={t.lists.log.description}
  section="log"
  ads={page.data.length > 0}
>
  {/* 인피드 슬롯에는 게이트가 없다 — 항목이 adAfter 개보다 적으면 Timeline 의
      루프가 애초에 광고 행을 만들지 않는다. 게이트가 필요한 곳은 로더 쪽(ads)이다. */}
  <Timeline locale={locale} groups={groups} adAfter={3} adSlot={AD_SLOTS.inFeed}>
    <Pagination
      locale={locale}
      base={sectionHref(locale, 'log')}
      page={page}
      unit={['ENTRY', 'ENTRIES']}
    />
  </Timeline>
</BaseLayout>
