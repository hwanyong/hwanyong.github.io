---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Timeline from '../../../components/Timeline.astro';
import { getSeriesTimeline, groupByYear, hasSeries } from '../../../lib/content';
import { AD_SLOTS } from '../../../lib/site';
import { LOCALE_CODES } from '../../../lib/i18n';
import { langParam, staticAlternates, sectionLabel } from '../../../lib/routes';
import { UI } from '../../../lib/ui';
import type { Locale } from '../../../lib/i18n';

// 개인 프로젝트 목록 (개정축). 정렬·draft 필터는 src/lib/content.ts 에 있다.

// 모든 로케일에 항상 존재하는 화면이다. 로케일은 콘텐츠가 아니라 이 표에서 나온다 —
// 방침·소개·목록은 번역이 없어도 URL 이 있어야 하는 유일한 부류다.
export const getStaticPaths = async () => {
  // 빈 축은 URL 을 만들지 않는다 — 헤더 네비에서 빠지는 것과 같은 규칙이고 같은 판정이다
  // (content.ts 의 liveNavSections). 한쪽만 적용하면 네비에 없는 화면이 sitemap 에 남는다.
  if (!(await hasSeries('project'))) return [];
  return LOCALE_CODES.map((locale) => ({ params: { lang: langParam(locale) }, props: { locale } }));
};

const { locale } = Astro.props as { locale: Locale };
const t = UI[locale];
const alternates = staticAlternates('project');

const items = await getSeriesTimeline('project', locale);
const groups = groupByYear(items);
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={sectionLabel('project')}
  description={t.lists.project.description}
  section="project"
  ads={items.length > 0}
  status={`${items.length} PROJECTS`}
>
  {/* 인피드 슬롯에는 게이트가 없다 — 항목이 adAfter 개보다 적으면 Timeline 의
      루프가 애초에 광고 행을 만들지 않는다. 게이트가 필요한 곳은 로더 쪽(ads)이다. */}
  <Timeline
    locale={locale}
    groups={groups}
    adAfter={3}
    adSlot={AD_SLOTS.inFeed}
  />
</BaseLayout>
