---
// src/pages/[...lang]/project/[series]/[...version].astro — 프로젝트 개정본 상세.
//
// 화면과 URL 규칙은 RevisionPage 가 전부 갖는다(프로젝트 축과 같은 골격).
// 이 파일이 하는 일은 "어느 컬렉션인가" 를 말하고 경로를 내는 것뿐이다.
//
// ★ getStaticPaths 는 격리 호이스팅된다 — import 와 함수 내부 선언만 쓴다.
import { render } from 'astro:content';
import RevisionPage from '../../../../components/RevisionPage.astro';
import VideoFacade from '../../../../components/VideoFacade.astro';
import {
  getCompanionCourse,
  getSeriesHistories,
  revisionAlternates,
  versionSlug,
} from '../../../../lib/content';
import type { ProjectEntry } from '../../../../lib/content';
import { langParam, sectionHref, sectionLabel } from '../../../../lib/routes';
import { DEFAULT_LOCALE } from '../../../../lib/i18n';
import type { Alternate, Locale } from '../../../../lib/i18n';
import { UI } from '../../../../lib/ui';

export const getStaticPaths = async () => {
  const histories = await getSeriesHistories('project');

  // 로케일 × 계열이 이미 갈려 있다 — 그 언어의 최신 개정본이 그 언어의 계열 루트다.
  return histories.flatMap((history) =>
    history.revisions.map((entry, index) => ({
      // 최신(index 0)은 version 을 비워 계열 루트로 낸다.
      // rest 파라미터는 빈 세그먼트도 매칭하므로 라우트 하나가 둘 다 낸다.
      params: {
        lang: langParam(history.locale),
        series: history.path,
        version: index === 0 ? undefined : versionSlug(entry),
      },
      props: {
        locale: history.locale,
        path: history.path,
        revisions: history.revisions,
        index,
        alternates: revisionAlternates(
          histories,
          history.path,
          index === 0 ? null : versionSlug(entry),
          DEFAULT_LOCALE,
        ),
      },
    })),
  );
};

type Props = {
  locale: Locale;
  /** 계열 이름. 이 축에서는 정체성과 같은 값이다(과목 같은 분류 단계가 없다). */
  path: string;
  revisions: ProjectEntry[];
  index: number;
  alternates: Alternate[];
};

const { locale, path, revisions, index, alternates }: Props = Astro.props;

const entry = revisions[index]!;
const { Content, headings } = await render(entry);

const { stack, links, thumbnail, video } = entry.data;
const t = UI[locale];

// 이 프로젝트에서 파생된 강의(있으면). 연결은 강의 표지의 project 필드가 SSOT 이고,
// 여기서 그것을 되짚어 "딸림 강의 →" 를 낸다 — 프로젝트 쪽엔 아무것도 적지 않는다.
const companion = await getCompanionCourse(locale, path);

// 링크는 스키마 순서가 아니라 여기 정한 순서로 나온다.
// 라벨을 마크업에 흩뿌리지 않으려고 한 표로 모아 둔다.
const LINK_LABELS = [
  ['repo', 'GitHub'],
  ['package', 'Package'],
  ['demo', 'Demo'],
] as const;

const linkRow = LINK_LABELS.flatMap(([key, label]) => {
  const href = links[key];
  return href ? [{ href, label }] : [];
});
---

<RevisionPage
  headings={headings}
  locale={locale}
  alternates={alternates}
  collection="project"
  path={path}
  identity={path}
  revisions={revisions}
  index={index}
  upHref={sectionHref(locale, 'project')}
  upLabel={sectionLabel('project')}
>
  {(stack.length > 0 || linkRow.length > 0 || companion) && (
    <dl class="fact" slot="lead">
      {stack.length > 0 && (
        <div class="fact__row">
          <dt>Stack</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
      )}
      {linkRow.length > 0 && (
        <div class="fact__row">
          <dt>Links</dt>
          <dd class="fact__links">
            {linkRow.map(({ href, label }) => (
              <a href={href} rel="noopener noreferrer" target="_blank">{label}</a>
            ))}
          </dd>
        </div>
      )}
      {/* 딸림 강의는 같은 사이트 안이라 새 탭으로 열지 않는다(외부 링크와 구분). */}
      {companion && (
        <div class="fact__row">
          <dt>{t.companionCourse}</dt>
          <dd class="fact__links">
            <a href={companion.href}>{companion.title} →</a>
          </dd>
        </div>
      )}
    </dl>
  )}

  {/* 영상이 있으면 본문보다 먼저. 재생 전에는 포스터 한 장이라 무겁지 않다.
      포스터는 목록 썸네일과 같은 파일을 쓴다 — 같은 그림을 두 번 두지 않는다. */}
  {video && thumbnail && (
    <VideoFacade locale={locale} id={video.id} title={video.title} poster={thumbnail} />
  )}

  <Content />
</RevisionPage>
