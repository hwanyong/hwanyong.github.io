---
// 강의 목록 (개정축). 정렬·draft 필터는 src/lib/content.ts 에 있다.
// 라우트 모양과 쪽 규칙은 log 목록과 같다 — 그쪽 주석을 볼 것.
//
// ★ 이 축은 지금 비어 있다. 그래도 화면과 URL 은 만든다 —
//   네비에서 사라지는 쪽은 "그런 축이 없다" 로 읽히고, 첫 강의를 넣기 전까지
//   그 자리를 확인할 방법도 없어진다. 비었다는 사실은 Timeline 이 직접 말한다.
//   광고는 싣지 않는다(ads={…length > 0}) — publisher content 가 없는 화면에
//   광고를 띄우는 것은 Google Publisher Policies 위반이다.
//
// ★ getStaticPaths 는 격리 호이스팅된다 — import 와 함수 내부 선언만 쓴다.
import type { Page, PaginateFunction } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Timeline from '../../../components/Timeline.astro';
import Pagination from '../../../components/Pagination.astro';
import { PAGE_SIZE, getSeriesTimeline, groupByYear } from '../../../lib/content';
import type { TimelineItem } from '../../../lib/content';
import { AD_SLOTS } from '../../../lib/site';
import { LOCALE_CODES } from '../../../lib/i18n';
import { langParam, pagedAlternates, sectionLabel } from '../../../lib/routes';
import { UI } from '../../../lib/ui';
import type { Locale } from '../../../lib/i18n';

export const getStaticPaths = async ({ paginate }: { paginate: PaginateFunction }) => {
  const perLocale = await Promise.all(
    LOCALE_CODES.map(async (locale) =>
      paginate(await getSeriesTimeline('lecture', locale), {
        params: { lang: langParam(locale) },
        props: { locale },
        pageSize: PAGE_SIZE,
      }),
    ),
  );
  return perLocale.flat();
};

const { locale, page } = Astro.props as { locale: Locale; page: Page<TimelineItem> };
const t = UI[locale];

const alternates = pagedAlternates('lecture', page.currentPage);

const groups = groupByYear(page.data);
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={sectionLabel('lecture')}
  description={t.lists.lecture.description}
  section="lecture"
  ads={page.data.length > 0}
>
  <Timeline
    locale={locale}
    groups={groups}
    adAfter={3}
    adSlot={AD_SLOTS.inFeed}
    empty={t.emptyLecture}
  >
    <Pagination locale={locale} section="lecture" page={page} unit={['SERIES', 'SERIES']} />
  </Timeline>
</BaseLayout>
