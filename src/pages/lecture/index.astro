---
// 강의 목록 (개정축). 정렬·draft 필터는 src/lib/content.ts 에 있다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getSeriesTimeline, groupByYear } from '../../lib/content';
import { AD_SLOTS } from '../../lib/site';

const items = await getSeriesTimeline('lecture');
const groups = groupByYear(items);
---

<BaseLayout
  title="Lecture"
  description="가르치며 고쳐 나가는 자료"
  section="lecture"
  status={`${items.length} SERIES`}
>
  <Timeline groups={groups} adAfter={3} adSlot={AD_SLOTS.inFeed} empty="아직 공개한 강의가 없습니다." />
</BaseLayout>
