---
// src/pages/lecture/[series]/[...version].astro — 강의 개정본 상세.
//
// 화면과 URL 규칙은 RevisionPage 가 전부 갖는다(프로젝트 축과 같은 골격).
// 이 파일이 하는 일은 "어느 컬렉션인가"를 말하고 경로를 내는 것뿐이다.
import { render } from 'astro:content';
import RevisionPage from '../../../components/RevisionPage.astro';
import { getSeriesHistories, versionSlug } from '../../../lib/content';
import type { LectureEntry } from '../../../lib/content';

export const getStaticPaths = async () => {
  const histories = await getSeriesHistories('lecture');

  return histories.flatMap(({ series, revisions }) =>
    revisions.map((entry, index) => ({
      // 최신(index 0)은 version 을 비워 계열 루트로 낸다.
      // rest 파라미터는 빈 세그먼트도 매칭하므로 라우트 하나가 둘 다 낸다.
      params: { series, version: index === 0 ? undefined : versionSlug(entry) },
      props: { revisions, index },
    })),
  );
};

type Props = { revisions: LectureEntry[]; index: number };

const { revisions, index }: Props = Astro.props;
const { Content } = await render(revisions[index]!);
---

<RevisionPage collection="lecture" rootLabel="Lecture" revisions={revisions} index={index}>
  <Content />
</RevisionPage>
