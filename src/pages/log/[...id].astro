---
// src/pages/log/[...id].astro — 글 상세
//
// rest 파라미터([...id])를 쓰는 이유: 하위 디렉터리나 frontmatter 의 slug 키 때문에
// id 에 "/" 가 들어가도 라우트가 깨지지 않게 하기 위해서다.
//
// 본문 렌더링은 entry.render() 가 아니라 astro:content 의 독립 함수 render(entry) 다.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import AdUnit from '../../components/AdUnit.astro';
import Toc from '../../components/Toc.astro';
import { getLogEntries } from '../../lib/content';
import type { LogEntry } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/date';
import { AD_SLOTS } from '../../lib/site';

export const getStaticPaths = async () => {
  const posts = await getLogEntries();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

type Props = { post: LogEntry };

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  section="log"
>
  <div class="column">
    <a class="back-link" href="/log/">← Log</a>

    {/* 넓은 화면에서 오른쪽 사이드 열로 빠진다(1280px 미만에서는 숨김). */}
    <Toc headings={headings} />

    <article>
      <header class="post-header">
        <div class="post-header__meta">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {post.data.tags.map((tag) => (
            <Fragment><span>·</span><span>{tag}</span></Fragment>
          ))}
        </div>
        <h1 class="post-header__title">{post.data.title}</h1>
        <p class="post-header__lead">{post.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {/* 광고는 본문이 끝난 뒤. 네비게이션 근처는 오클릭 유발로 정책상 위험하다.
        prop 이름은 slot 이 아니라 adSlot 이어야 한다(slot 은 Astro 예약 속성). */}
    <AdUnit adSlot={AD_SLOTS.articleEnd} collapseOnUnfilled={false} />

    <Comments />
  </div>
</BaseLayout>
