---
// src/pages/log/[...id].astro — 글 상세
//
// rest 파라미터([...id])를 쓰는 이유: 하위 디렉터리나 frontmatter 의 slug 키 때문에
// id 에 "/" 가 들어가도 라우트가 깨지지 않게 하기 위해서다.
//
// 본문 렌더링은 entry.render() 가 아니라 astro:content 의 독립 함수 render(entry) 다.
//
// 화면 골격(이동 줄·글 머리·댓글·광고 순서)은 ArticleShell 이 전부 갖는다.
// 이 파일은 "이 축이 무엇을 채우는가"만 말한다.
import { render } from 'astro:content';
import ArticleShell from '../../components/ArticleShell.astro';
import Toc from '../../components/Toc.astro';
import { getLogEntries } from '../../lib/content';
import type { LogEntry } from '../../lib/content';
import { DEFAULT_LOCALE } from '../../lib/i18n';
import { sectionHref, sectionLabel } from '../../lib/routes';

export const getStaticPaths = async () => {
  const posts = await getLogEntries();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

type Props = { post: LogEntry };

const { post } = Astro.props;
const { Content, headings } = await render(post);

// S3 에서 Astro.props.locale 로 대체된다.
const locale = DEFAULT_LOCALE;
---

<ArticleShell
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  meta={post.data.tags}
  section="log"
  backHref={sectionHref(locale, 'log')}
  backLabel={sectionLabel('log')}
>
  {/* 넓은 화면에서 오른쪽 사이드 열로 빠진다(1280px 미만에서는 숨김). */}
  <Toc locale={locale} headings={headings} slot="aside" />

  <Content />
</ArticleShell>
