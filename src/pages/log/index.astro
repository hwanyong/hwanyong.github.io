---
// 글 목록 (시간축). 정렬·draft 필터는 src/lib/content.ts 에 있다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getLogTimeline, groupByYear } from '../../lib/content';
import { AD_SLOTS } from '../../lib/site';

const items = await getLogTimeline();
const groups = groupByYear(items);
---

<BaseLayout
  title="Log"
  description="기술 글 목록"
  section="log"
  status={`${items.length} ENTRIES`}
>
  <Timeline groups={groups} adAfter={3} adSlot={AD_SLOTS.inFeed} />
</BaseLayout>
