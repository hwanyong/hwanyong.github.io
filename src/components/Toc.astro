---
/**
 * 목차. 넓은 화면에서만 본문 오른쪽 사이드 열에 붙는다.
 *
 * 좁은 화면에서는 .aside 가 본문 흐름 안으로 들어가는데, 그 자리에 목차가
 * 끼어들면 읽기를 방해하기만 한다. 그래서 CSS 에서 1280px 미만일 때 숨긴다
 * (내용이 중복이지 소실이 아니다 — 본문에 같은 제목이 그대로 있다).
 */
import { UI } from '../lib/ui';
import type { Locale } from '../lib/i18n';
import type { MarkdownHeading } from 'astro';

interface Props {
  locale: Locale;
  headings: MarkdownHeading[];
}

const { locale, headings } = Astro.props;

// h2·h3 만. h4 이하까지 넣으면 사이드가 본문의 축소판이 되어 훑는 기능을 잃는다.
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 1 && (
    <nav class="aside toc" aria-label={UI[locale].toc}>
      <div class="toc__head">{UI[locale].toc}</div>
      <ol>
        {items.map((h) => (
          <li data-depth={h.depth}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
