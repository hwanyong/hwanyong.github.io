---
/**
 * AdSense 로더 + 광고 슬롯 초기화기.
 * 반드시 <head> 안에, 페이지당 정확히 한 번만 렌더링한다.
 *
 * is:inline 이 필수인 이유
 *  1) Astro 는 속성 없는 <script> 를 TS 변환 + 번들 + type="module" 로 바꾼다.
 *  2) Deduplication: 같은 컴포넌트가 한 페이지에 여러 번 쓰이면 스크립트는 딱
 *     한 번만 출력된다. 슬롯마다 push({}) 를 넣으면 슬롯 3개에 push 1개가 되어
 *     2·3번째 광고가 영원히 빈칸이 된다(빌드 에러 없이 조용히 실패).
 *  3) 외부 URL 스크립트는 "외부라서" 자동 제외되는 게 아니다. 공식 문서는
 *     src/ 바깥 스크립트에 is:inline 을 붙이라고 명시한다.
 *
 * 주의: is:inline 스크립트 "본문" 안에서는 Astro 표현식이 평가되지 않는다.
 *      {`...`} 로 감싸면 백틱과 중괄호가 그대로 출력되어 JS 가 깨진다.
 *      순수 JS 를 그대로 적을 것. (속성값 표현식 src={...} 은 정상 평가된다.)
 */
import { ADSENSE } from '../lib/site';

const isProd = import.meta.env.PROD;
const loaderSrc = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`;
---
{
  isProd && (
    <>
      {/* Google 공식 스니펫 그대로: async + crossorigin="anonymous" 두 속성뿐.
          integrity(SRI) 를 붙이면 안 된다 — Google 이 내용을 계속 바꾸므로 차단된다. */}
      <script is:inline async src={loaderSrc} crossorigin="anonymous"></script>

      <script is:inline>
        (function () {
          // window 에 보관 — 스크립트가 재실행돼도 중복 push 를 막는다.
          window.__adPushed = window.__adPushed || new WeakSet();

          function initAdSlots() {
            var slots = document.querySelectorAll('ins.adsbygoogle');
            for (var i = 0; i < slots.length; i++) {
              var el = slots[i];
              // 이미 채워진 슬롯을 다시 push 하는 것은 정책상 '새로고침'이다. 금지.
              if (window.__adPushed.has(el)) continue;
              window.__adPushed.add(el);
              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              } catch (e) {
                console.warn('[adsense] push failed', e);
                break;
              }
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAdSlots, { once: true });
          } else {
            initAdSlots();
          }

          // ClientRouter(뷰 트랜지션)를 나중에 켤 경우를 대비한 훅.
          // astro:page-load 는 ClientRouter 가 없으면 발화하지 않으므로 무해하다.
          if (!window.__adRouterBound) {
            window.__adRouterBound = true;
            document.addEventListener('astro:page-load', initAdSlots);
          }
        })();
      </script>
    </>
  )
}
