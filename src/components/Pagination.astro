---
/**
 * 목록의 쪽 이동 줄.
 *
 * ── 이 줄이 총 개수를 말하는 이유 ────────────────────────────────────────────
 * 예전에는 헤더 오른쪽 상태 칩이 "10 PROJECTS" 처럼 총 개수를 말했다. 그 자리는
 * 화면마다 뜻이 달라지는 자리이고(REV 2 / 2 · 404 · 시행일), 목록의 개수는
 * 목록을 다 읽은 사람이 "여기가 끝인가" 를 물을 때 필요하다. 그래서 개수를
 * 목록 끝, 쪽 이동과 같은 줄로 옮긴다 — 물음이 생기는 자리에 답을 둔다.
 *
 * ── 문구 ────────────────────────────────────────────────────────────────────
 * PREV · NEXT · PAGE 1 / 3 · 24 ENTRIES 는 전부 계기판 표기라 번역하지 않는다
 * (REV 2 / 2 · REFLECT / EMIT 와 같은 부류). 번역되는 것은 <nav> 의 이름 하나뿐이다.
 * 화살표는 aria-hidden 이라 접근 가능한 이름은 "PREV" · "NEXT" 그대로다.
 *
 * ★ 항목이 0개면 이 줄을 그리지 않는다. 그 화면에는 Timeline 이 이미 "아직 없습니다"
 *   를 그리고 있고, 그 옆의 "0 ENTRIES" 는 같은 말을 두 번 하는 것이다.
 */
import type { Page } from 'astro';
import type { TimelineItem } from '../lib/content';
import type { Locale } from '../lib/i18n';
import { pageHref, type NavSection } from '../lib/routes';
import { UI } from '../lib/ui';

interface Props {
  locale: Locale;
  /** 어느 목록의 쪽인가. 주소를 만드는 데 쓴다. */
  section: NavSection;
  page: Page<TimelineItem>;
  /**
   * 세는 단위의 [단수, 복수]. 계기판 어휘라 대문자 라틴이고 로케일과 무관하다.
   * log 는 글을 세고(ENTRY/ENTRIES) 개정축은 계열을 센다(SERIES) — 개정본 수가 아니다.
   *
   * 두 벌을 받는 이유는 "1 ENTRIES" 를 내지 않기 위해서다. 규칙으로 만들지 않는 이유는
   * 영어의 복수형이 규칙적이지 않기 때문이다 — SERIES 는 단수와 복수가 같다.
   */
  unit: readonly [one: string, many: string];
}

const { locale, section, page, unit } = Astro.props;

const t = UI[locale];
const [one, many] = unit;

/*
  이동 주소는 Astro 가 준 것이 아니라 routes.ts 의 pageHref 로 만든다.

  ★ paginate() 가 만드는 주소에는 끝 슬래시가 없다(/log/2). 실측: Astro 는
    config.trailingSlash 를 그대로 getRouteGenerator 에 넘기는데, 기본값 'ignore' 에서는
    슬래시를 붙이지 않는다. 이 사이트는 build.format:'directory' 라 정본 주소가
    /log/2/ 이므로, 그대로 쓰면 내부 링크마다 리다이렉트가 한 번씩 끼고
    사이트 안에서 두 가지 주소 표기가 섞인다.

  ★ 더 중요한 이유는 출처가 하나여야 한다는 것이다. head 의 hreflang 도 pageHref 로
    만든다 — 화면의 이동 링크와 hreflang 이 다른 함수에서 나오면 서로 다른 쪽을
    가리켜도 아무 데서도 걸리지 않는다. 지금은 둘이 같은 함수라 어긋날 수 없고,
    그 함수가 옳은지는 tools/verify-site.ts 가 sitemap 과 값까지 대조해 확인한다.
*/
const prevHref =
  page.currentPage > 1 ? pageHref(locale, section, page.currentPage - 1) : undefined;
const nextHref =
  page.currentPage < page.lastPage ? pageHref(locale, section, page.currentPage + 1) : undefined;
---

{
  page.total > 0 && (
    <nav class="pager" aria-label={t.pageNav}>
      {prevHref && (
        <a class="pager__step pager__step--prev" href={prevHref} rel="prev">
          <span aria-hidden="true">←</span> PREV
        </a>
      )}

      <span class="pager__count">
        {page.lastPage > 1 && (
          <b>
            PAGE {page.currentPage} / {page.lastPage}
          </b>
        )}
        {page.total} {page.total === 1 ? one : many}
      </span>

      {nextHref && (
        <a class="pager__step pager__step--next" href={nextHref} rel="next">
          NEXT <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  )
}

{/* .pager 스타일은 src/styles/global.css 에 있다. */}
