---
/**
 * 글 하나를 보여주는 상세 화면의 골격. 세 축(log · lecture · project)이 공유한다.
 *
 * 왜 컴포넌트인가: 두 축의 상세 페이지가 같은 뼈대를 각자 하드코딩하고 있었고,
 * 그 사이에서 드리프트가 났다 — 같은 광고·댓글이 한쪽은 광고→댓글, 다른 쪽은
 * 댓글→광고 순서였다. 정책이 두 파일에 서로 반대로 박혀 있으면 어느 쪽이 규약인지
 * 코드가 말해주지 못한다. 순서·여백·광고 정책은 이제 이 파일 한 곳에서만 정한다.
 *
 * 축마다 다른 부속은 슬롯으로 받는다:
 *   aside  — 본문 '앞'에 놓이는 부속 (목차)
 *   notice — 글 머리 바로 아래 안내 (구버전 개정본 알림)
 *   after  — 본문 '뒤', 댓글 앞에 놓이는 부속 (개정 이력)
 *   (기본)  — 본문
 *
 * aside 와 after 를 나눈 이유: 넓은 화면에서는 .aside 가 사이드 열(3번 트랙)로
 * 명시 배치되어 DOM 위치와 무관하지만, 사이드 열이 닫힌 좁은 화면에서는 DOM 순서가
 * 곧 화면 순서다. 목차는 본문보다 먼저 와야 하고(좁은 화면에서는 아예 감춰진다),
 * 개정 이력은 댓글 바로 위에 있어야 한다. 한 슬롯으로는 둘을 다 만족시킬 수 없다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostNav from './PostNav.astro';
import Comments from './Comments.astro';
import AdUnit from './AdUnit.astro';
import { formatDate, isoDate } from '../lib/date';
import { AD_SLOTS } from '../lib/site';
import type { Locale } from '../lib/i18n';
import type { NavSection } from '../lib/routes';

interface Props {
  locale: Locale;
  /** 화면의 h1. 별도 지정이 없으면 <title> 로도 쓰인다. */
  title: string;
  /** 브라우저 탭·OG 제목을 h1 과 다르게 둘 때만 준다. 예: "analysis-video v1.0" */
  documentTitle?: string;
  description: string;
  date: Date;
  /** 날짜 뒤에 " · " 로 이어 붙는 항목들. 예: 태그, 버전, "현재" */
  meta?: string[];
  section?: NavSection | null;
  /** 헤더 우측 상태 표시 */
  status?: string;
  /** 되돌아갈 곳. 위·아래 이동 줄이 같은 곳을 가리킨다. */
  backHref: string;
  backLabel: string;
  /** 상단 이동 줄 오른쪽의 건너뛰기 링크 (PostNav 로 그대로 넘어간다) */
  jumpHref?: string;
  jumpLabel?: string;
  /**
   * giscus 검색어. 주면 mapping="specific" 으로 그 검색어에 묶이고,
   * 없으면 기본값인 pathname 기준이 된다. 개정축처럼 URL 이 여럿이어도
   * 한 Discussion 을 공유해야 하는 축이 이 값을 준다.
   */
  commentTerm?: string;
  /**
   * 광고 게재 여부. 로더(BaseLayout)와 슬롯을 한 값으로 함께 켜고 끈다 —
   * 한쪽만 켜지면 로더 없는 빈 <ins> 가 남거나 슬롯 없는 로더가 실린다.
   */
  ads?: boolean;
}

const {
  locale,
  title,
  documentTitle,
  description,
  date,
  meta = [],
  section = null,
  status,
  backHref,
  backLabel,
  jumpHref,
  jumpLabel,
  commentTerm,
  ads = true,
} = Astro.props;
---

<BaseLayout
  locale={locale}
  title={documentTitle ?? title}
  description={description}
  type="article"
  publishedTime={date}
  section={section}
  status={status}
  ads={ads}
>
  <div class="column">
    <PostNav
      locale={locale}
      href={backHref}
      label={backLabel}
      jumpHref={jumpHref}
      jumpLabel={jumpLabel}
    />

    <slot name="aside" />

    <article>
      <header class="post-header">
        <div class="post-header__meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {meta.map((item) => (
            <Fragment><span>·</span><span>{item}</span></Fragment>
          ))}
        </div>
        <h1 class="post-header__title">{title}</h1>
        <p class="post-header__lead">{description}</p>
      </header>

      <slot name="notice" />

      <div class="prose">
        <slot />
      </div>
    </article>

    <PostNav locale={locale} href={backHref} label={backLabel} place="foot" />

    <slot name="after" />

    <Comments locale={locale} mapping={commentTerm ? 'specific' : 'pathname'} term={commentTerm} />

    {/*
      광고는 반드시 이동 줄에서 떨어진 맨 아래. 네비게이션에 붙여 두면 오클릭을
      유발해 정책상 위험하다. 아래쪽 이동 줄이 생긴 이상 그 바로 뒤는 쓸 수 없어
      댓글 뒤로 못박는다 — 축마다 순서가 달랐던 문제가 여기서 끝난다.
    */}
    {ads && <AdUnit adSlot={AD_SLOTS.articleEnd} collapseOnUnfilled={false} />}
  </div>
</BaseLayout>

{/* .post-nav / .post-header / .prose / .stale-notice 스타일은 src/styles/global.css 에 있다.
    스타일이 컴포넌트마다 흩어지면 토큰 SSOT 가 깨진다. */}
