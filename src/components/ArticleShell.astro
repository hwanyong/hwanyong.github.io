---
/**
 * 글 하나를 보여주는 상세 화면의 골격. 세 축(log · lecture · project)이 공유한다.
 *
 * 왜 컴포넌트인가: 두 축의 상세 페이지가 같은 뼈대를 각자 하드코딩하고 있었고,
 * 그 사이에서 드리프트가 났다 — 같은 광고·댓글이 한쪽은 광고→댓글, 다른 쪽은
 * 댓글→광고 순서였다. 정책이 두 파일에 서로 반대로 박혀 있으면 어느 쪽이 규약인지
 * 코드가 말해주지 못한다. 순서·여백·광고 정책은 이제 이 파일 한 곳에서만 정한다.
 *
 * 축마다 다른 부속은 슬롯으로 받는다:
 *   aside  — 본문 '앞'에 놓이는 부속 (목차)
 *   notice — 글 머리 바로 아래 안내 (구버전 개정본 알림)
 *   after  — 본문 '뒤', 댓글 앞에 놓이는 부속 (개정 이력)
 *   (기본)  — 본문
 *
 * aside 와 after 를 나눈 이유: 넓은 화면에서는 .aside 가 사이드 열(3번 트랙)로
 * 명시 배치되어 DOM 위치와 무관하지만, 사이드 열이 닫힌 좁은 화면에서는 DOM 순서가
 * 곧 화면 순서다. 목차는 본문보다 먼저 와야 하고(좁은 화면에서는 아예 감춰진다),
 * 개정 이력은 댓글 바로 위에 있어야 한다. 한 슬롯으로는 둘을 다 만족시킬 수 없다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostNav from './PostNav.astro';
import Comments from './Comments.astro';
import AdUnit from './AdUnit.astro';
import { formatDate, isoDate } from '../lib/date';
import { AD_SLOTS } from '../lib/site';
import { LOCALES, type Alternate, type Locale } from '../lib/i18n';
import type { NavSection } from '../lib/routes';
import { UI } from '../lib/ui';

interface Props {
  locale: Locale;
  /** 이 글의 언어별 주소. BaseLayout 이 head 와 언어 스위처에 그대로 넘긴다. */
  alternates: Alternate[];
  /**
   * 이 판본이 아직 번역되지 않은 사본이면 원문의 로케일.
   *
   * 값이 있으면 화면이 셋을 한다: 본문 위 안내 · <article lang> 을 원문 언어로 ·
   * (목록에서는) 배지. 스크린리더가 한국어 골격 안의 영어 본문을 영어로 읽게 하려면
   * lang 이 반드시 실제 본문 언어여야 한다 — 안내 문구만으로는 부족하다.
   */
  untranslated?: Locale;
  /** 화면의 h1. 별도 지정이 없으면 <title> 로도 쓰인다. */
  title: string;
  /** 브라우저 탭·OG 제목을 h1 과 다르게 둘 때만 준다. 예: "analysis-video v1.0" */
  documentTitle?: string;
  description: string;
  date: Date;
  /** 날짜 뒤에 " · " 로 이어 붙는 항목들. 예: 태그, 버전, "현재" */
  meta?: string[];
  section?: NavSection | null;
  /** 되돌아갈 곳. 위·아래 이동 줄이 같은 곳을 가리킨다. */
  backHref: string;
  backLabel: string;
  /** 상단 이동 줄 오른쪽의 건너뛰기 링크 (PostNav 로 그대로 넘어간다) */
  jumpHref?: string;
  jumpLabel?: string;
  /**
   * giscus 검색어. 언어 무관·개정 무관 통합 키다.
   * ★ 필수다 — URL 이 댓글의 정체성을 소유하지 않는다.
   */
  commentTerm: string;
  /**
   * 광고 게재 여부. 로더(BaseLayout)와 슬롯을 한 값으로 함께 켜고 끈다 —
   * 한쪽만 켜지면 로더 없는 빈 <ins> 가 남거나 슬롯 없는 로더가 실린다.
   */
  ads?: boolean;
}

const {
  locale,
  alternates,
  untranslated,
  title,
  documentTitle,
  description,
  date,
  meta = [],
  section = null,
  backHref,
  backLabel,
  jumpHref,
  jumpLabel,
  commentTerm,
  ads = true,
} = Astro.props;

const t = UI[locale];
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={documentTitle ?? title}
  description={description}
  type="article"
  publishedTime={date}
  section={section}
  ads={ads}
>
  <div class="column">
    <PostNav
      locale={locale}
      href={backHref}
      label={backLabel}
      jumpHref={jumpHref}
      jumpLabel={jumpLabel}
    />

    {/* lang 은 ★실제 본문 언어★ 다. 번역이 없어 원문을 그대로 싣고 있으면
        페이지 골격(<html lang>)과 다른 값이 되며, 그것이 정확한 서술이다. */}
    <article lang={untranslated ? LOCALES[untranslated].htmlLang : undefined}>
      <header class="post-header">
        <div class="post-header__meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {meta.map((item) => (
            <Fragment><span>·</span><span>{item}</span></Fragment>
          ))}
        </div>
        <h1 class="post-header__title">{title}</h1>
        <p class="post-header__lead">{description}</p>
      </header>

      {/* 안내문은 읽는 사람의 언어로 쓴다 — 이 문장만은 본문 언어를 따르지 않는다.
          원문을 못 읽는 사람에게 "못 읽는 언어로 못 읽는다고 알리는" 꼴이 되기 때문이다. */}
      {untranslated && (
        <p class="stale-notice" lang={LOCALES[locale].htmlLang}>
          {t.untranslatedNotice(t.languageNames[untranslated])}
        </p>
      )}

      <slot name="notice" />

      <div class="prose">
        <slot />
      </div>
    </article>

    <PostNav locale={locale} href={backHref} label={backLabel} place="foot" />

    {/* 사이드 레일 — 넓은 화면에서 3번 트랙에 올라가는 유일한 요소다.
        목차와 개정 이력을 ★한 상자★ 에 담는 이유: 둘 다 각자 3번 트랙에 놓이면
        같은 칸에서 겹친다. 그래서 축마다 하나만 골라 싣고 있었고(로그=목차,
        강의·프로젝트=개정 이력) 그게 화면마다 다른 부속이 뜨는 원인이었다.
        상자가 하나면 있는 것만 위에서부터 쌓이고, 축이 무엇을 갖든 화면은 같다.

        놓이는 자리가 '본문 뒤 · 댓글 앞' 인 것은 ★좁은 화면★ 때문이다. 사이드 열이
        닫히면 DOM 순서가 곧 화면 순서인데, 그때 개정 이력은 댓글 바로 위가 맞고
        목차는 어차피 감춰진다(.toc 의 미디어쿼리). 넓은 화면에서는 명시 배치라
        DOM 위치와 무관하다. */}
    {(Astro.slots.has('aside') || Astro.slots.has('after')) && (
      <div class="side-rail">
        <slot name="aside" />
        <slot name="after" />
      </div>
    )}

    <Comments locale={locale} term={commentTerm} />

    {/*
      광고는 반드시 이동 줄에서 떨어진 맨 아래. 네비게이션에 붙여 두면 오클릭을
      유발해 정책상 위험하다. 아래쪽 이동 줄이 생긴 이상 그 바로 뒤는 쓸 수 없어
      댓글 뒤로 못박는다 — 축마다 순서가 달랐던 문제가 여기서 끝난다.
    */}
    {ads && <AdUnit adSlot={AD_SLOTS.articleEnd} collapseOnUnfilled={false} />}
  </div>
</BaseLayout>

{/* .post-nav / .post-header / .prose / .stale-notice 스타일은 src/styles/global.css 에 있다.
    스타일이 컴포넌트마다 흩어지면 토큰 SSOT 가 깨진다. */}
