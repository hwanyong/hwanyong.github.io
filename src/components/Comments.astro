---
/**
 * giscus 댓글 위젯.
 *
 * - 일반 글(log):  <Comments />                          → mapping="pathname"
 * - 작업물(work):  <Comments mapping="specific" term={`work:${project}`} />
 *                  → v1-0 / v1-1 페이지가 URL 이 달라도 같은 Discussion 을 공유한다.
 *
 * 왜 순수 <script> 임베드인가:
 *   giscus 는 React/Vue/Svelte/Solid 래퍼와 Web Component(`npm i giscus` →
 *   <giscus-widget>)를 공식 제공한다. Web Component 는 Astro 에서도 그대로 쓸 수
 *   있는 정식 경로다. 여기서 굳이 순수 script 를 쓰는 이유는 (a) 런타임 의존성 0,
 *   (b) 최초 렌더 시점의 REFLECT/EMIT 상태를 data-theme 에 직접 주입해
 *   테마 깜빡임을 없애기 위해서다. Web Component 로 바꿔도 무방하다.
 */
import { GISCUS } from '../lib/site';

interface Props {
  mapping?: 'pathname' | 'url' | 'title' | 'og:title' | 'specific' | 'number';
  /** mapping 이 'specific'(검색어) 또는 'number'(Discussion 번호)일 때만 사용 */
  term?: string;
}

const { mapping = 'pathname', term } = Astro.props;

// dev 서버(http://localhost:4321)는 CORS 헤더를 주지 않으므로
// giscus iframe 이 crossorigin="anonymous" 로 커스텀 테마 CSS 를 못 읽는다.
// dev 에서는 빌트인 테마를 쓰고, 프로덕션에서만 자체 호스팅 CSS 를 쓴다.
const isDev = import.meta.env.DEV;
---

<section class="comments" aria-label="댓글">
  <h2 class="comments__title">댓글</h2>
  {/* giscus client.js 가 이 요소를 찾아 내부를 비우고 iframe 을 삽입한다. */}
  <div class="giscus"></div>
</section>

{/* define:vars 는 is:inline 을 함축한다. 명시하지 않으면 astro check 가 힌트를 낸다. */}
<script is:inline define:vars={{ GISCUS, mapping, term, isDev }}>
  (function () {
    var root = document.documentElement;

    function modeOf() {
      return root.dataset.mode === 'emit' ? 'emit' : 'reflect';
    }

    function themeFor(mode) {
      if (isDev) return GISCUS.devTheme[mode];
      return GISCUS.themeBase + '/' + mode + '.css';
    }

    var container = document.querySelector('.giscus');
    if (!container) return;

    var injected = false;
    function inject() {
      if (injected) return;
      injected = true;

      var s = document.createElement('script');
      s.src = GISCUS.origin + '/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';

      // dataset 의 camelCase 는 data-kebab-case 로 정확히 변환된다.
      s.dataset.repo = GISCUS.repo;                 // data-repo
      s.dataset.repoId = GISCUS.repoId;             // data-repo-id
      s.dataset.category = GISCUS.category;         // data-category (카테고리 한정 검색)
      s.dataset.categoryId = GISCUS.categoryId;     // data-category-id
      s.dataset.mapping = mapping;                  // data-mapping
      s.dataset.strict = '1';                       // data-strict (퍼지 검색 오매칭 방지)
      s.dataset.reactionsEnabled = '1';
      s.dataset.emitMetadata = '0';
      s.dataset.inputPosition = 'bottom';
      s.dataset.theme = themeFor(modeOf());         // data-theme 는 기본값이 없다. 필수.
      s.dataset.lang = 'ko';                        // → https://giscus.app/ko/widget
      s.dataset.loading = 'lazy';                   // → iframe loading="lazy"
      if (term) s.dataset.term = term;              // data-term (specific / number 전용)

      // ★ container.appendChild(s) 로 넣으면 안 된다.
      //   client.js 는 .giscus 컨테이너를 찾은 뒤 firstChild 를 전부 제거하므로
      //   방금 넣은 <script> 자신이 DOM 에서 사라진다. 형제로 붙인다.
      container.insertAdjacentElement('afterend', s);
    }

    var io = null;
    if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              io.disconnect();
              inject();
              return;
            }
          }
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(container);
    } else {
      inject();
    }

    // REFLECT <-> EMIT 토글 동기화. iframe 리로드 없이 테마만 교체된다.
    function pushTheme(mode) {
      var iframe = document.querySelector('iframe.giscus-frame');
      if (!iframe || !iframe.contentWindow) return;
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: themeFor(mode) } } },
        GISCUS.origin,
      );
    }

    var mo = new MutationObserver(function () {
      pushTheme(modeOf());
    });
    mo.observe(root, { attributes: true, attributeFilter: ['data-mode'] });

    // ClientRouter 를 켤 경우 옵저버가 페이지마다 누적되는 것을 막는다.
    // ClientRouter 가 없으면 이 이벤트는 발화하지 않으므로 무해하다.
    document.addEventListener(
      'astro:before-swap',
      function () {
        mo.disconnect();
        if (io) io.disconnect();
      },
      { once: true },
    );
  })();
</script>

<style>
  .comments {
    margin-block-start: 4rem;
  }
  .comments__title {
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-block-end: 1.25rem;
  }
</style>
